{
  "name": "autosoccer-sim",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.19",
  "engines": {
    "bun": "1.2.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/viewer dev",
    "build": "bun run --cwd apps/viewer build",
    "headless": "bun packages/match-runner/src/cli.ts",
    "test": "vitest run && bun scripts/golden.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "walkthrough": "node scripts/walkthrough-m3.mjs",
    "test:unit": "vitest run",
    "golden:write": "bun scripts/golden.ts --write",
    "walkthrough:m1": "node scripts/record-walkthrough.mjs",
    "soak": "bun packages/match-runner/src/soak-cli.ts",
    "walkthrough:m2": "node scripts/walkthrough-m2.mjs"
  },
  "devDependencies": {
    "@autosoccer/controller-runtime": "workspace:*",
    "@autosoccer/controller-sdk": "workspace:*",
    "@autosoccer/match-runner": "workspace:*",
    "@autosoccer/sim-core": "workspace:*",
    "@autosoccer/telemetry": "workspace:*",
    "@types/node": "22.10.2",
    "playwright": "1.49.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
